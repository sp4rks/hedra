meta {
  name: Create tenant
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/tenants
  body: json
  auth: none
}

body:json {
  {
    "name": "Acme",
    "tenantDomain": "{{tenantDomain}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar('tenantId', res.body.data.id)
  }
}
