meta {
  name: Filter environments
  type: http
  seq: 4
}

get {
  url: {{tenantUrl}}/environments?filter={"environmentDomain":"{{environmentDomain}}"}
  body: none
  auth: none
}

params:query {
  filter: {"environmentDomain":"{{environmentDomain}}"}
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.status === 200 && Array.isArray(res.body?.data)) {
    bru.setVar('filteredEnvironmentList', res.body.data)
  }
}
