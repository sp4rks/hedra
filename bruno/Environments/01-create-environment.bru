meta {
  name: Create environment
  type: http
  seq: 1
}

post {
  url: {{tenantUrl}}/environments
  body: json
  auth: none
}

body:json {
  {
    "name": "Development",
    "environmentDomain": "{{environmentDomainLabel}}.{{tenantDomain}}"
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar('environmentDomainLabel', bru.interpolate('{{$randomDomainWord}}'))
}

script:post-response {
  const data = res.body?.data
  
  if (res.status === 201 && typeof data?.id === 'string' && typeof data?.environmentDomain === 'string') {
    bru.setVar('environmentId', data.id)
    bru.setVar('environmentDomain', data.environmentDomain)
    bru.setVar('environmentObject', data)
  }
}
