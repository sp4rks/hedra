meta {
  name: List tenants
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/tenants
  body: none
  auth: none
}

tests {
  test('lists the created tenant', function () {
    expect(res.status).to.equal(200)
    expect(res.body.data).to.be.an('array')
    expect(res.body.data.some(tenant => tenant.id === bru.getVar('tenantId'))).to.equal(true)
  })
}
