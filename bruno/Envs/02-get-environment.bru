meta {
  name: Get environment
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/environments/{{environmentDomain}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

script:post-response {
  const data = res.body?.data

  if (res.status === 200 && typeof data?.id === 'string' && typeof data?.environmentDomain === 'string') {
    bru.setVar('environmentId', data.id)
    bru.setVar('environmentDomain', data.environmentDomain)
    bru.setVar('environmentObject', data)
  }
}
