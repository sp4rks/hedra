meta {
  name: Create tenant
  type: http
  seq: 1
}

post {
  url: {{deploymentUrl}}/tenants
  body: json
  auth: none
}

body:json {
  {
    "name": "Acme",
    "tenantDomain": "{{$randomDomainWord}}.{{baseDomain}}"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  const data = res.body?.data

  if (res.status === 201 && typeof data?.id === 'string' && typeof data?.tenantDomain === 'string') {
    bru.setVar('tenantId', data.id)
    bru.setVar('tenantDomain', data.tenantDomain)
    bru.setVar('tenantObject', data)
  }
}
