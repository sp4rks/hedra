meta {
  name: Get tenant
  type: http
  seq: 2
}

get {
  url: {{deploymentUrl}}/tenants/{{tenantDomain}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

script:post-response {
  const data = res.body?.data

  if (res.status === 200 && typeof data?.id === 'string' && typeof data?.tenantDomain === 'string') {
    bru.setVar('tenantId', data.id)
    bru.setVar('tenantDomain', data.tenantDomain)
    bru.setVar('tenantObject', data)
  }
}
