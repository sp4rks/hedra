meta {
  name: Filter tenants
  type: http
  seq: 4
}

get {
  url: {{deploymentUrl}}/tenants?filter={"tenantDomain":"{{tenantDomain}}"}
  body: none
  auth: none
}

params:query {
  filter: {"tenantDomain":"{{tenantDomain}}"}
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.status === 200 && Array.isArray(res.body?.data)) {
    bru.setVar('filteredTenantList', res.body.data)
  }
}
