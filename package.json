{
  "name": "hedra",
  "module": "src/hedra.ts",
  "type": "module",
  "private": true,
  "imports": {
    "#config": "./src/server/config/config.ts",
    "#config/*": "./src/server/config/*",
    "#errors": "./src/server/errors/errors.ts",
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "bun --watch src/hedra.ts",
    "start": "bun src/hedra.ts",
    "test": "bun test",
    "fmt": "biome check --write .",
    "check": "tsc --noEmit && biome check . && bun test"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
