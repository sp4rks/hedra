{
  "name": "hedra",
  "module": "src/hedra.ts",
  "type": "module",
  "private": true,
  "imports": {
    "#config": "./src/server/config.ts",
    "#config/*": "./src/server/configs/*",
    "#controllers": "./src/controllers/controllers.ts",
    "#datastores": "./src/datastores/datastores.ts",
    "#models": "./src/models/models.ts",
    "#models/*": "./src/models/*",
    "#errors": "./src/server/errors.ts",
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "bun --watch examples/01-helloworld.ts",
    "start": "bun examples/01-helloworld.ts",
    "count": "bun scripts/count.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "fmt": "biome check --write .",
    "check": "tsc --noEmit && biome check . && bun run test:coverage"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@biomejs/runtime": "2.6.3",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
